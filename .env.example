# ---- Server (all optional) ----
# Port the Node server listens on.
PORT=8787
# SQLite file (directory is created). Use a persistent volume in production.
DATABASE_PATH=./data/manhunt.db
# Serve the built SPA from here (production). Leave unset in dev (Vite serves it).
# STATIC_DIR=./dist/web
# Trust X-Forwarded-For / Fly-Client-IP for rate limiting (true behind a proxy/CDN).
TRUST_PROXY=false
# Comma-separated list of allowed WebSocket origins, e.g. https://manhunt.example.com
# PUBLIC_ORIGIN=
# Delete reveal coordinates this many minutes after a game ends.
LOCATION_RETENTION_MINUTES=60
# Delete whole games this many hours after they end.
GAME_RETENTION_HOURS=24
# Delete idle lobbies after this many hours.
LOBBY_IDLE_HOURS=12
# Testing only: allow ping intervals < 60 s and simulated GPS. Default: on in dev, off in production.
# ALLOW_FAST_PINGS=false
# ALLOW_SIMULATION=false
# Testing only: multiply REST rate limits.
# RATE_LIMIT_SCALE=1

# Optional Google Maps Platform browser key (Map Tiles API + Places API (New)).
# Restrict it to your site's address and those two APIs in Google Cloud.
# GOOGLE_MAPS_API_KEY=

# ---- Client build-time (Vite) ----
# MapLibre style URLs. Defaults: OpenFreeMap (free, no key).
# VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# Satellite raster tiles ({z}/{y}/{x} or {z}/{x}/{y} template) and attribution.
# VITE_SATELLITE_TILES=
# VITE_SATELLITE_ATTRIBUTION=
